# Server
DATABASE_URL=postgresql://jobtrack_user:change_me@localhost:5432/jobtrack
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
PORT=5000
CORS_ORIGIN=http://localhost:5173

# SMTP email delivery (use an app password where your provider requires one)
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_smtp_username
EMAIL_PASSWORD=your_smtp_password
EMAIL_FROM=JobTrack <noreply@example.com>

# Google Identity Services web client ID. A client secret is not used for
# Google ID-token verification, so do not add one unless another flow needs it.
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

